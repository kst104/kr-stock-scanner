# ── deepflow 환경설정 (BYOK) ──
# 이 파일을 .env 로 복사한 뒤 본인 KIS 키를 입력하세요.
# 값은 로컬에서만 사용되며 외부 서버로 전송되지 않습니다.

# KIS Developers 에서 발급한 App Key / App Secret
#   https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=

# 발급한 키의 환경: real(실전) 또는 demo(모의투자)
KIS_TRADING_ENV=real

# ── 선택 설정 ──
# 웹 서버 주소/포트
DEEPFLOW_HOST=127.0.0.1
DEEPFLOW_PORT=8077

# 시작 시 브라우저 자동 오픈 (1/0)
DEEPFLOW_OPEN_BROWSER=1

# KIS 키 없이 UI 를 확인하려면 1 로 설정 (합성 데이터, 실데이터 아님)
DEEPFLOW_DEMO=0
